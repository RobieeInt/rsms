{
	"info": {
		"name": "RSMS - Reconext Service Management System",
		"description": "API Collection untuk RSMS (Reconext Service Management System)\n\n## Cara Pakai\n1. Login terlebih dahulu di endpoint **Auth > Login**\n2. Copy token dari response\n3. Klik folder collection \"RSMS API\" di Postman\n4. Buka tab **Authorization** → pilih **Bearer Token** → paste token\n5. Semua request di dalam collection akan otomatis pakai token tersebut",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"email\": \"admin@reconext.com\",\n\t\"password\": \"password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/login",
							"host": ["{{base_url}}"],
							"path": ["login"]
						},
						"description": "Login dan dapatkan token. Token disimpan di variable `token` untuk semua request lainnya."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.environment.set('token', jsonData.token);",
									"    console.log('Token saved: ' + jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/logout",
							"host": ["{{base_url}}"],
							"path": ["logout"]
						},
						"description": "Logout dan hapus token."
					}
				},
				{
					"name": "Get Current User",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/user",
							"host": ["{{base_url}}"],
							"path": ["user"]
						},
						"description": "Ambil data user yang sedang login."
					}
				}
			]
		},
